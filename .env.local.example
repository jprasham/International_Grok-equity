ANTHROPIC_API_KEY=your-anthropic-api-key

# Public base URL of this app, used to build the bot's callbackUrl.
APP_URL=http://localhost:3000

# Where POST /api/research sends jobs. The token is optional and sent as a Bearer token.
RESEARCH_WEBHOOK_URL=https://bot.example.com/research
RESEARCH_WEBHOOK_TOKEN=your-webhook-token

# Bearer secret the bot must send on callbacks. Callbacks are refused if this is unset.
REPORT_CALLBACK_SECRET=generate-a-long-random-string
